# Hadirku — Absensi Siswa (multi-tenant)
# Salin file ini menjadi .env.local untuk development lokal.
# JANGAN pernah commit file .env.local / .env berisi secret.

# --- Auth.js ---
# Hasil `npx auth secret` (atau string acak >= 32 karakter).
AUTH_SECRET=

# URL publik aplikasi, tanpa trailing slash. Contoh: https://hadirku.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Google OAuth (registrasi sekolah, Tahap 2) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Service Account (akses REGISTRY milik platform, Tahap 1+) ---
# Email SA, dan private key (ganti \n literal dengan newline asli di Vercel).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# ID spreadsheet REGISTRY (tab `schools`). Sheet di-share hanya ke email SA.
REGISTRY_SHEET_ID=

# --- Enkripsi refresh token (AES-256-GCM) ---
# 32 byte acak, di-encode base64 (44 karakter). Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# --- Upstash Redis (cache, lock, rate limit) ---
# Kosongkan untuk memakai fallback memory lokal (dev/test saja, bukan produksi).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Mode deploy ---
# multitenant | selfhost (selfhost = Tahap 9)
DEPLOY_MODE=multitenant

# --- Self-host (satu sekolah, Service Account, tanpa OAuth/registry) ---
# Isi bila DEPLOY_MODE=selfhost. Lihat README bagian "Jalur self-host".
# SELFHOST_SPREADSHEET_ID=
# SELFHOST_SLUG=sekolah
# SELFHOST_SCHOOL_NAME=

# --- Postgres (opsional, untuk migrasi manual) ---
# Lihat docs/postgres-schema.sql dan scripts/migrate-sheets-to-postgres.ts.
# DATABASE_URL=postgresql://user:pass@localhost:5432/hadirku
